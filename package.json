{
  "name": "salama-shule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "demo": "npm run build && npm start",
    "reset-db": "rm -rf .data",
    "security-check": "node tests/security-check.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@hono/node-server": "^2.1.5",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
